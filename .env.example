# Flask Application Environment Variables
# Copy this file to .env and configure for your environment
# NEVER commit .env file with actual secrets to version control!

# Flask Debug Mode - set to 'true' only in development
# WARNING: Never enable in production - exposes sensitive data and allows RCE
FLASK_DEBUG=false

# Secret key for session management and CSRF protection
# Generate a secure key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secure-secret-key-here

# Server binding configuration
# Use 127.0.0.1 for local development, specific IP for controlled deployment
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
